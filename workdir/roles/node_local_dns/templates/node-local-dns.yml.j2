apiVersion: v1
kind: ServiceAccount
metadata:
  name: node-local-dns
  namespace: kube-system
  labels:
    kubernetes.io/cluster-service: "true"
---
apiVersion: v1
kind: Service
metadata:
  name: kube-dns-upstream
  namespace: kube-system
  labels:
    k8s-app: kube-dns
    kubernetes.io/cluster-service: "true"
spec:
  ports:
    - name: dns
      port: 53
      protocol: UDP
      targetPort: 53
    - name: dns-tcp
      port: 53
      protocol: TCP
      targetPort: 53
  selector:
    k8s-app: kube-dns
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: node-local-dns
  namespace: kube-system
data:
  Corefile: |
    {{ node_local_dns_domain }}:53 {
        errors
        cache {
            success {{ node_local_dns_cache_success_entries }} 30
            denial {{ node_local_dns_cache_denial_entries }} 5
        }
        reload
        loop
        bind {{ node_local_dns_address }} {{ node_local_dns_service_ip }}
        forward . __PILLAR__CLUSTER__DNS__ {
            force_tcp
            max_concurrent {{ node_local_dns_max_concurrent_queries }}
        }
        prometheus :9253
        health {{ node_local_dns_address }}:8080
    }
    in-addr.arpa:53 {
        errors
        cache {
            success {{ node_local_dns_cache_success_entries }} 30
            denial {{ node_local_dns_cache_denial_entries }} 5
        }
        reload
        loop
        bind {{ node_local_dns_address }} {{ node_local_dns_service_ip }}
        forward . __PILLAR__CLUSTER__DNS__ {
            force_tcp
            max_concurrent {{ node_local_dns_max_concurrent_queries }}
        }
        prometheus :9253
    }
    ip6.arpa:53 {
        errors
        cache {
            success {{ node_local_dns_cache_success_entries }} 30
            denial {{ node_local_dns_cache_denial_entries }} 5
        }
        reload
        loop
        bind {{ node_local_dns_address }} {{ node_local_dns_service_ip }}
        forward . __PILLAR__CLUSTER__DNS__ {
            force_tcp
            max_concurrent {{ node_local_dns_max_concurrent_queries }}
        }
        prometheus :9253
    }
    .:53 {
        errors
        cache {
            success {{ node_local_dns_cache_success_entries }} 30
            denial {{ node_local_dns_cache_denial_entries }} 5
        }
        reload
        loop
        bind {{ node_local_dns_address }} {{ node_local_dns_service_ip }}
        forward . __PILLAR__UPSTREAM__SERVERS__ {
            max_concurrent {{ node_local_dns_max_concurrent_queries }}
        }
        prometheus :9253
    }
---
apiVersion: apps/v1
kind: DaemonSet
metadata:
  name: node-local-dns
  namespace: kube-system
  labels:
    k8s-app: node-local-dns
    kubernetes.io/cluster-service: "true"
spec:
  updateStrategy:
    rollingUpdate:
      maxUnavailable: 1
  selector:
    matchLabels:
      k8s-app: node-local-dns
  template:
    metadata:
      labels:
        k8s-app: node-local-dns
      annotations:
        prometheus.io/port: "9253"
        prometheus.io/scrape: "true"
    spec:
      priorityClassName: system-node-critical
      serviceAccountName: node-local-dns
      hostNetwork: true
      dnsPolicy: Default
      tolerations:
        - operator: Exists
          effect: NoExecute
        - operator: Exists
          effect: NoSchedule
      containers:
        - name: node-cache
          image: {{ node_local_dns_image }}
          imagePullPolicy: IfNotPresent
          resources:
            requests:
              cpu: 25m
              memory: 20Mi
          args:
            - "-localip"
            - "{{ node_local_dns_address }},{{ node_local_dns_service_ip }}"
            - "-conf"
            - /etc/Corefile
            - "-upstreamsvc"
            - kube-dns-upstream
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              add:
                - NET_ADMIN
                - NET_BIND_SERVICE
              drop:
                - ALL
          ports:
            - containerPort: 53
              name: dns
              protocol: UDP
            - containerPort: 53
              name: dns-tcp
              protocol: TCP
            - containerPort: 9253
              name: metrics
              protocol: TCP
          livenessProbe:
            httpGet:
              host: "{{ node_local_dns_address }}"
              path: /health
              port: 8080
            initialDelaySeconds: 60
            timeoutSeconds: 5
          volumeMounts:
            - mountPath: /run/xtables.lock
              name: xtables-lock
              readOnly: false
            - mountPath: /etc/coredns
              name: config-volume
            - mountPath: /etc/kube-dns
              name: kube-dns-config
      volumes:
        - name: xtables-lock
          hostPath:
            path: /run/xtables.lock
            type: FileOrCreate
        - name: kube-dns-config
          configMap:
            name: kube-dns
            optional: true
        - name: config-volume
          configMap:
            name: node-local-dns
            items:
              - key: Corefile
                path: Corefile.base
---
apiVersion: v1
kind: Service
metadata:
  name: node-local-dns
  namespace: kube-system
  labels:
    k8s-app: node-local-dns
  annotations:
    prometheus.io/port: "9253"
    prometheus.io/scrape: "true"
spec:
  clusterIP: None
  ports:
    - name: metrics
      port: 9253
      targetPort: 9253
  selector:
    k8s-app: node-local-dns
